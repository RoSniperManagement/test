                table.insert(layers.secondShells, {part = shell2, source = part, partName = partName})
                table.insert(layers.welds, w1)
                table.insert(layers.welds, w2)
            end
        end
        
        return layers
    end,
    
    Update = function(player, layers, baseColor, dt, t)
        local seed = StableHash(player, 13)
        
        -- Base hue rotates slowly
        local baseHue = (t * 0.08 + seed) % 1
        
        for _, hl in ipairs(layers.highlights) do
            if hl and hl.Parent then
                -- Highlight shows the "average" spectral color
                local avgHue = (baseHue + 0.0) % 1
                hl.FillColor = FromHSV(avgHue, 0.7, 0.95)
                hl.OutlineColor = FromHSV((avgHue + 0.5) % 1, 0.8, 1)
                -- Subtle transparency oscillation
                local breath = 0.5 + 0.5 * math.sin(t * 0.8)
                hl.FillTransparency = 0.65 + breath * 0.1
            end
        end
        
        for _, lightData in ipairs(layers.lights) do
            local light = lightData.light
            local pn = lightData.partName
            if light and light.Parent then
                local si = PartSpatialIndex[pn] or {index = 0}
                -- Each part gets a hue offset based on position (prismatic spread)
                local prismOffset = si.index * 0.12
                local partHue = (baseHue + prismOffset) % 1
                -- Add noise wobble to the hue
                local noiseWobble = Perlin2D(t * 0.5, si.index * PHI * 10) * 0.04
                light.Color = FromHSV((partHue + noiseWobble) % 1, 0.9, 1)
                light.Brightness = 1.5 + math.sin(t * 2 + si.index * PHI) * 0.8
                light.Range = 5 + math.sin(t * 1.3 + si.index * 1.7) * 2
            end
        end
        
        -- Primary shells: main spectral color per part
        for _, shellData in ipairs(layers.shells) do
            local shell = shellData.part
            local source = shellData.source
            local pn = shellData.partName
            if shell and shell.Parent and source and source.Parent then
                local si = PartSpatialIndex[pn] or {index = 0}
                local prismOffset = si.index * 0.12
                local partHue = (baseHue + prismOffset) % 1
                shell.Color = FromHSV(partHue, 0.95, 1)
                
                -- Chromatic breathing
                local breath = math.sin(t * 1.5 + si.index * PHI * TAU)
                shell.Transparency = 0.78 + breath * 0.06
                shell.Size = source.Size * (1.04 + breath * 0.015)
            end
        end
        
        -- Secondary shells: complementary/shifted wavelength
        for _, shellData in ipairs(layers.secondShells or {}) do
            local shell = shellData.part
            local source = shellData.source
            local pn = shellData.partName
            if shell and shell.Parent and source and source.Parent then
                local si = PartSpatialIndex[pn] or {index = 0}
                local prismOffset = si.index * 0.12
                -- Shift by ~120 degrees for triadic chromatic split
                local partHue = (baseHue + prismOffset + 0.33) % 1
                shell.Color = FromHSV(partHue, 0.8, 0.9)
                
                local wave = math.sin(t * 0.9 + si.index * PHI * 2.3)
                shell.Transparency = 0.87 + wave * 0.05
                shell.Size = source.Size * (1.08 + wave * 0.02)
            end
        end
    end,
}


