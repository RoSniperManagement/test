            if part and part:IsA("BasePart") then
                local light = Instance.new("PointLight")
                light.Name = "X3_ESP_Plasma"
                light.Brightness = 2.5; light.Range = 8; light.Shadows = false
                light.Parent = part
                table.insert(layers.lights, {light = light, partName = partName})
                
                local shell = Instance.new("Part")
                shell.Name = "X3_ESP_PlasmaShell"
                shell.Size = part.Size * 1.08
                shell.CFrame = part.CFrame
                shell.Material = Enum.Material.Neon
                shell.Transparency = 0.75
                shell.CanCollide = false; shell.CanQuery = false; shell.CanTouch = false
                shell.Massless = true; shell.Anchored = false; shell.CastShadow = false
                shell.Parent = character
                
                if partName == "Head" then
                    local mesh = Instance.new("SpecialMesh", shell)
                    mesh.MeshType = Enum.MeshType.Head
                    mesh.Scale = Vector3.new(1.25 * 1.08, 1.25 * 1.08, 1.25 * 1.08)
                end
                
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = part; weld.Part1 = shell; weld.Parent = shell
                table.insert(layers.shells, {part = shell, source = part, partName = partName})
                table.insert(layers.welds, weld)
            end
        end
        
        return layers
    end,
    
    Update = function(player, layers, baseColor, dt, t)
        local seed = StableHash(player, 42)
        
        -- Classic plasma: sum of 2D sine fields at different angles/frequencies
        -- But here we use each part's spatial position as the 2D coordinate
        -- so the pattern flows across the body
        
        for _, hl in ipairs(layers.highlights) do
            if hl and hl.Parent then
                -- Global highlight gets the torso's plasma value
                local px, py = 0, 0 -- torso is at center
                local v1 = math.sin(px * 2.0 + t * 1.3)
                local v2 = math.sin(py * 2.5 + t * 0.9)
                local v3 = math.sin((px + py + t) * 1.5)
                local v4 = math.sin(math.sqrt(px * px + py * py + 1) * 2.0 + t)
                local plasma = (v1 + v2 + v3 + v4) / 4 -- [-1, 1]
                local hue = ((plasma + 1) / 2 + t * 0.05 + seed) % 1
                local plasmaColor = FromHSV(hue, 0.85, 0.95)
                hl.FillColor = plasmaColor
                hl.OutlineColor = FromHSV((hue + 0.5) % 1, 0.9, 1)
                hl.FillTransparency = 0.5 + math.abs(plasma) * 0.15
            end
        end
        
        for _, lightData in ipairs(layers.lights) do
            local light = lightData.light
            local pn = lightData.partName
            if light and light.Parent then
                local si = PartSpatialIndex[pn] or {x = 0, y = 0, index = 0}
                local px, py = si.x, si.y
                
                local v1 = math.sin(px * 2.0 + t * 1.3)
                local v2 = math.sin(py * 2.5 + t * 0.9)
                local v3 = math.sin((px + py + t) * 1.5)
                local v4 = math.sin(math.sqrt(px * px + py * py + 1) * 2.0 + t)
                local plasma = (v1 + v2 + v3 + v4) / 4
                local hue = ((plasma + 1) / 2 + t * 0.05 + seed) % 1
                
                light.Color = FromHSV(hue, 0.9, 1)
                light.Brightness = 2 + math.abs(plasma) * 2.5
                light.Range = 5 + math.abs(plasma) * 6
            end
        end
        
        for _, shellData in ipairs(layers.shells) do
            local shell = shellData.part
            local source = shellData.source
            local pn = shellData.partName
            if shell and shell.Parent and source and source.Parent then
                local si = PartSpatialIndex[pn] or {x = 0, y = 0, index = 0}
                local px, py = si.x, si.y
                
                local v1 = math.sin(px * 2.0 + t * 1.3)
                local v2 = math.sin(py * 2.5 + t * 0.9)
                local v3 = math.sin((px + py + t) * 1.5)
                local v4 = math.sin(math.sqrt(px * px + py * py + 1) * 2.0 + t)
                local plasma = (v1 + v2 + v3 + v4) / 4
                local hue = ((plasma + 1) / 2 + t * 0.05 + seed + 0.15) % 1
                
                shell.Color = FromHSV(hue, 0.95, 1)
                shell.Transparency = 0.7 + (1 - math.abs(plasma)) * 0.15
                -- Plasma makes shells throb
                local throb = 1.06 + math.abs(plasma) * 0.04
                shell.Size = source.Size * throb
            end
        end
    end,
}


-- ============================================
-- MODE 4: SPECTRAL CHROMATIC
-- Chromatic dispersion effect - each body part has a slightly different
-- hue velocity creating a prismatic separation
-- ============================================
ESPModes["Spectral"] = {
    Name = "Spectral",
    Description = "Prismatic chromatic dispersion with per-part wavelength separation",
    
    Setup = function(player, character, baseColor, isTeammate)
