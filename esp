                table.insert(layers.shells, {part = shell, source = part, partName = partName})
                table.insert(layers.welds, weld)
                
                -- Per-part glitch state
                layers.glitchState[partName] = {
                    flickerTimer = 0,
                    flickerDuration = 0,
                    isFlickering = false,
                    offsetColor = Color3.new(0, 1, 0.7),
                    scanPhase = math.random() * TAU,
                }
            end
        end
        
        return layers
    end,
    
    Update = function(player, layers, baseColor, dt, t)
        -- Glitch palette: cyberpunk neon
        local glitchColors = {
            Color3.fromRGB(0, 255, 180),   -- cyan-green
            Color3.fromRGB(255, 0, 100),   -- hot pink
            Color3.fromRGB(120, 0, 255),   -- purple
            Color3.fromRGB(255, 255, 0),   -- yellow
            Color3.fromRGB(0, 150, 255),   -- blue
            Color3.fromRGB(255, 80, 0),    -- orange
        }
        
        -- Global scan line effect (moves up the body)
        local scanY = math.sin(t * 3.5) * 3 -- oscillates between -3 and 3 (body range)
        local scanWidth = 0.8
        
        -- Major glitch events (whole-body flicker)
        local majorGlitch = PoissonEvent("glitch_major_" .. player.UserId, 0.8, dt)
        
        if majorGlitch then
            local gc = glitchColors[math.random(1, #glitchColors)]
            for _, hl in ipairs(layers.highlights) do
                if hl and hl.Parent then
                    hl.FillColor = gc
                    hl.OutlineColor = glitchColors[math.random(1, #glitchColors)]
                    hl.FillTransparency = 0.2 + math.random() * 0.3
                end
            end
        else
            -- Normal state: subtle base color
            local baseGlitch = Color3.fromRGB(0, 255, 180)
            for _, hl in ipairs(layers.highlights) do
                if hl and hl.Parent then
                    -- Slowly lerp back to base
                    hl.FillColor = LerpColor3(hl.FillColor, baseGlitch, dt * 5)
                    hl.OutlineColor = LerpColor3(hl.OutlineColor, Color3.fromRGB(255, 0, 100), dt * 5)
                    hl.FillTransparency = hl.FillTransparency + (0.6 - hl.FillTransparency) * dt * 8
                end
            end
        end
        
        -- Per-part effects
        for _, lightData in ipairs(layers.lights) do
            local light = lightData.light
            local pn = lightData.partName
            if light and light.Parent then
                local gs = layers.glitchState[pn]
                if not gs then continue end
                
                local si = PartSpatialIndex[pn] or {x = 0, y = 0, index = 0}
                
                -- Scan line proximity
                local scanDist = math.abs(si.y - scanY)
                local scanInfluence = math.clamp(1 - scanDist / scanWidth, 0, 1)
                
                -- Per-part micro-glitch (Poisson events)
                local partGlitch = PoissonEvent("glitch_" .. player.UserId .. "_" .. pn, 2.5, dt)
                
                if partGlitch then
                    light.Color = glitchColors[math.random(1, #glitchColors)]
                    light.Brightness = 4 + math.random() * 4
                    light.Range = 8 + math.random() * 8
                else
                    -- Scan line drives brightness
                    light.Color = LerpColor3(light.Color, Color3.fromRGB(0, 255, 180), dt * 6)
                    light.Brightness = 1.5 + scanInfluence * 3
                    light.Range = 4 + scanInfluence * 5
                end
            end
        end
        
        for _, shellData in ipairs(layers.shells) do
            local shell = shellData.part
            local source = shellData.source
            local pn = shellData.partName
            if shell and shell.Parent and source and source.Parent then
                local si = PartSpatialIndex[pn] or {x = 0, y = 0, index = 0}
                local scanDist = math.abs(si.y - scanY)
                local scanInfluence = math.clamp(1 - scanDist / scanWidth, 0, 1)
                
                local partGlitch = PoissonEvent("glitch_shell_" .. player.UserId .. "_" .. pn, 1.5, dt)
                
                if partGlitch then
                    shell.Color = glitchColors[math.random(1, #glitchColors)]
                    shell.Transparency = 0.4 + math.random() * 0.3
                    -- Glitch can make shell jump in size
                    shell.Size = source.Size * (1.0 + math.random() * 0.15)
                else
                    shell.Color = LerpColor3(shell.Color, Color3.fromRGB(0, 255, 180), dt * 4)
                    shell.Transparency = 0.82 - scanInfluence * 0.2
                    shell.Size = source.Size * (1.03 + scanInfluence * 0.04)
                end
            end
        end
    end,
}


