                    local m2 = Instance.new("SpecialMesh", shell2)
                    m2.MeshType = Enum.MeshType.Head; m2.Scale = Vector3.new(1.25*1.10,1.25*1.10,1.25*1.10)
                end
                
                local w1 = Instance.new("WeldConstraint"); w1.Part0 = part; w1.Part1 = shell1; w1.Parent = shell1
