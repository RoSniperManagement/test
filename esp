                shell.Transparency = 0.25 + noise * 0.15
                shell.Size = source.Size * (1.04 + voidBreath * 0.03)
            end
        end
        
        -- Corona shells
        for _, shellData in ipairs(layers.secondShells or {}) do
            local shell = shellData.part
            local source = shellData.source
            local pn = shellData.partName
            if shell and shell.Parent and source and source.Parent then
                local si = PartSpatialIndex[pn] or {index = 0}
                local distFromCenter = math.sqrt((PartSpatialIndex[pn] or {x=0}).x^2 + (PartSpatialIndex[pn] or {y=0}).y^2)
                local ripple = math.sin(ripplePhase - distFromCenter * 1.5) * 0.5 + 0.5
                
                shell.Color = FromHSV(0.75 + ripple * 0.1, 0.8, 0.4 + ripple * 0.4)
                shell.Transparency = 0.82 - ripple * 0.15
                -- Corona expands and contracts with the void breathing
                shell.Size = source.Size * (1.12 + voidBreath * 0.06 + ripple * 0.03)
            end
        end
    end,
}


-- ============================================
-- MODE 8: CASCADE
-- Sequential activation traveling through body with afterglow trails
-- ============================================
ESPModes["Cascade"] = {
    Name = "Cascade",
    Description = "Sequential wave of light that cascades through body parts with persistent afterglow",

    Setup = function(player, character, baseColor, isTeammate)
        local layers = {highlights = {}, lights = {}, shells = {}, welds = {}}

        local hl = Instance.new("Highlight")
        hl.Name = "X3_ESP_Cascade"
        hl.Adornee = character
        hl.FillTransparency = 0.75
        hl.OutlineTransparency = 0.2
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = character
        table.insert(layers.highlights, hl)

        for _, partName in ipairs(R6Parts) do
            local part = character:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                local light = Instance.new("PointLight")
                light.Name = "X3_ESP_Cascade"
                light.Brightness = 0.5; light.Range = 3; light.Shadows = false
                light.Parent = part
                table.insert(layers.lights, {light = light, partName = partName})

                local shell = Instance.new("Part")
                shell.Name = "X3_ESP_CascadeShell"
                shell.Size = part.Size * 1.05
                shell.CFrame = part.CFrame
                shell.Material = Enum.Material.Neon
                shell.Transparency = 0.9
                shell.CanCollide = false; shell.CanQuery = false; shell.CanTouch = false
                shell.Massless = true; shell.Anchored = false; shell.CastShadow = false
                shell.Parent = character

                if partName == "Head" then
                    local mesh = Instance.new("SpecialMesh", shell)
                    mesh.MeshType = Enum.MeshType.Head
                    mesh.Scale = Vector3.new(1.25*1.05,1.25*1.05,1.25*1.05)
                end

                local weld = Instance.new("WeldConstraint")
                weld.Part0 = part; weld.Part1 = shell; weld.Parent = shell
                table.insert(layers.shells, {part = shell, source = part, partName = partName})
                table.insert(layers.welds, weld)
            end
        end

        return layers
    end,

    Update = function(player, layers, baseColor, dt, t)
        -- Cascade path: defines the order the light travels
        local cascadePath = {"Left Leg", "Right Leg", "Torso", "Left Arm", "Right Arm", "Head"}
        local totalParts = #cascadePath
        local cascadeSpeed = 1.2 -- full cycles per second
        local trailLength = 0.4 -- how long the afterglow persists (0-1 of cycle)

        local cyclePhase = (t * cascadeSpeed) % 1 -- 0 to 1

        -- The "active" position travels through 0 to totalParts
        local activePos = cyclePhase * totalParts

        for _, hl in ipairs(layers.highlights) do
            if hl and hl.Parent then
                hl.FillColor = baseColor
                hl.OutlineColor = baseColor
                -- Overall glow follows the cascade
                local maxIntensity = 0
                for i = 1, totalParts do
                    local dist = math.abs(activePos - (i - 0.5))
                    dist = math.min(dist, totalParts - dist) -- wrap around
                    local intensity = math.clamp(1 - dist / (totalParts * trailLength), 0, 1)
                    maxIntensity = math.max(maxIntensity, intensity)
                end
                hl.FillTransparency = 0.8 - maxIntensity * 0.25
                hl.OutlineTransparency = 0.3 - maxIntensity * 0.25
            end
        end

        for _, lightData in ipairs(layers.lights) do
            local light = lightData.light
            local pn = lightData.partName
            if light and light.Parent then
                -- Find this part's index in the cascade path
                local partIdx = 0
                for i, name in ipairs(cascadePath) do
                    if name == pn then partIdx = i - 0.5; break end
                end

                -- Distance from the active position (with wrapping)
                local dist = math.abs(activePos - partIdx)
                dist = math.min(dist, totalParts - dist)
                local intensity = math.clamp(1 - dist / (totalParts * trailLength), 0, 1)
                -- Smooth the intensity curve
                intensity = intensity * intensity * (3 - 2 * intensity) -- smoothstep

                -- Color shifts along the trail (leading edge is bright white, trail fades to base)
                local trailPos = math.clamp((activePos - partIdx) / (totalParts * trailLength), -1, 1)
                if trailPos < 0 then trailPos = trailPos + totalParts end
                local leadColor = LerpColor3(baseColor, Color3.new(1, 1, 1), math.clamp(1 - math.abs(trailPos) * 2, 0, 0.6))

                light.Color = leadColor
                light.Brightness = intensity * 5
                light.Range = 3 + intensity * 10
            end
        end

        for _, shellData in ipairs(layers.shells) do
            local shell = shellData.part
            local source = shellData.source
            local pn = shellData.partName
            if shell and shell.Parent and source and source.Parent then
                local partIdx = 0
                for i, name in ipairs(cascadePath) do
                    if name == pn then partIdx = i - 0.5; break end
                end

                local dist = math.abs(activePos - partIdx)
                dist = math.min(dist, totalParts - dist)
                local intensity = math.clamp(1 - dist / (totalParts * trailLength), 0, 1)
                intensity = intensity * intensity * (3 - 2 * intensity)

                shell.Color = LerpColor3(baseColor, Color3.new(1, 1, 1), intensity * 0.3)
                shell.Transparency = 0.92 - intensity * 0.45
                shell.Size = source.Size * (1.03 + intensity * 0.07)
            end
        end
    end,
}


-- ============================================
-- MODE 9: ELECTRIC ARC
-- Simulated electrical discharge with per-part crackling and arc flashes
-- ============================================
ESPModes["Electric"] = {
    Name = "Electric",
    Description = "Electrical discharge with per-part crackling, arc flashes, and chain lightning simulation",

    Setup = function(player, character, baseColor, isTeammate)
        local layers = {highlights = {}, lights = {}, shells = {}, welds = {}}

        local hl = Instance.new("Highlight")
        hl.Name = "X3_ESP_Electric"
        hl.Adornee = character
        hl.FillColor = Color3.fromRGB(80, 200, 255)
        hl.FillTransparency = 0.7
        hl.OutlineColor = Color3.fromRGB(200, 240, 255)
        hl.OutlineTransparency = 0.0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = character
        table.insert(layers.highlights, hl)

        for _, partName in ipairs(R6Parts) do
            local part = character:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                local light = Instance.new("PointLight")
                light.Name = "X3_ESP_Electric"
                light.Color = Color3.fromRGB(100, 200, 255)
                light.Brightness = 1.5; light.Range = 5; light.Shadows = false
                light.Parent = part
                table.insert(layers.lights, {light = light, partName = partName})

                local shell = Instance.new("Part")
                shell.Name = "X3_ESP_ElectricShell"
                shell.Size = part.Size * 1.04
                shell.CFrame = part.CFrame
                shell.Material = Enum.Material.Neon
                shell.Color = Color3.fromRGB(80, 180, 255)
                shell.Transparency = 0.85
                shell.CanCollide = false; shell.CanQuery = false; shell.CanTouch = false
                shell.Massless = true; shell.Anchored = false; shell.CastShadow = false
                shell.Parent = character

                if partName == "Head" then
                    local mesh = Instance.new("SpecialMesh", shell)
                    mesh.MeshType = Enum.MeshType.Head
                    mesh.Scale = Vector3.new(1.25*1.04,1.25*1.04,1.25*1.04)
                end

                local weld = Instance.new("WeldConstraint")
                weld.Part0 = part; weld.Part1 = shell; weld.Parent = shell
                table.insert(layers.shells, {part = shell, source = part, partName = partName})
                table.insert(layers.welds, weld)

                -- Spark particles
                local sparks = Instance.new("ParticleEmitter")
                sparks.Name = "X3_ESP_Sparks"
                sparks.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 240, 255)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 180, 255)),
                })
                sparks.Size = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.08),
                    NumberSequenceKeypoint.new(0.3, 0.04),
                    NumberSequenceKeypoint.new(1, 0),
                })
                sparks.Rate = 0 -- controlled by update
                sparks.Speed = NumberRange.new(3, 8)
                sparks.Lifetime = NumberRange.new(0.1, 0.3)
                sparks.SpreadAngle = Vector2.new(180, 180)
                sparks.LightEmission = 2
                sparks.LightInfluence = 0
                sparks.Acceleration = Vector3.new(0, -20, 0)
                sparks.Parent = part
                table.insert(layers.lights, {particle = sparks, partName = partName})
            end
        end

        return layers
    end,

    Update = function(player, layers, baseColor, dt, t)
        -- Electric colors
        local coreColor = Color3.fromRGB(80, 200, 255)
        local flashColor = Color3.fromRGB(230, 250, 255)

        -- Random arc discharge events
        local majorArc = PoissonEvent("elec_major_" .. player.UserId, 3, dt)

        for _, hl in ipairs(layers.highlights) do
            if hl and hl.Parent then
                if majorArc then
                    hl.FillColor = flashColor
                    hl.FillTransparency = 0.3
                    hl.OutlineColor = Color3.new(1, 1, 1)
                    hl.OutlineTransparency = 0
                else
                    hl.FillColor = LerpColor3(hl.FillColor, coreColor, dt * 8)
                    hl.FillTransparency = hl.FillTransparency + (0.7 - hl.FillTransparency) * dt * 6
                    hl.OutlineColor = LerpColor3(hl.OutlineColor, Color3.fromRGB(200, 240, 255), dt * 8)
                    hl.OutlineTransparency = hl.OutlineTransparency + (0.05 - hl.OutlineTransparency) * dt * 6
                end
            end
        end

        for _, lightData in ipairs(layers.lights) do
            local light = lightData.light
            local particle = lightData.particle
            local pn = lightData.partName

            if light and light.Parent then
                local si = PartSpatialIndex[pn] or {index = 0}
                local partArc = PoissonEvent("elec_" .. player.UserId .. "_" .. pn, 5, dt)

                if partArc or majorArc then
                    light.Color = flashColor
                    light.Brightness = 6 + math.random() * 4
                    light.Range = 10 + math.random() * 8
                else
                    light.Color = LerpColor3(light.Color, coreColor, dt * 10)
                    -- Constant low-level crackle
                    local crackle = math.abs(Perlin2D(t * 15, si.index * 7.3))
                    light.Brightness = 1 + crackle * 1.5
                    light.Range = 4 + crackle * 3
                end
            end

            if particle and particle.Parent then
                local partArc = PoissonEvent("elec_spark_" .. player.UserId .. "_" .. pn, 4, dt)
                particle.Rate = partArc and 80 or (majorArc and 40 or 3)
            end
        end

        for _, shellData in ipairs(layers.shells) do
            local shell = shellData.part
            local source = shellData.source
            local pn = shellData.partName
            if shell and shell.Parent and source and source.Parent then
                local partArc = PoissonEvent("elec_sh_" .. player.UserId .. "_" .. pn, 4, dt)

                if partArc or majorArc then
                    shell.Color = flashColor
                    shell.Transparency = 0.5 + math.random() * 0.2
                    shell.Size = source.Size * (1.02 + math.random() * 0.06)
                else
                    shell.Color = LerpColor3(shell.Color, coreColor, dt * 6)
                    shell.Transparency = shell.Transparency + (0.85 - shell.Transparency) * dt * 5
                    shell.Size = source.Size * 1.04
                end
            end
        end
    end,
}


-- ============================================
-- UNIVERSAL CLEANUP FOR ALL MODES
-- ============================================
local function CleanupESPLayers(layerData)
    if not layerData then return end
    for _, hl in ipairs(layerData.highlights or {}) do pcall(function() if hl and hl.Parent then hl:Destroy() end end) end
    for _, lightData in ipairs(layerData.lights or {}) do
        if type(lightData) == "table" then
            if lightData.light then pcall(function() if lightData.light.Parent then lightData.light:Destroy() end end) end
            if lightData.particle then pcall(function() if lightData.particle.Parent then lightData.particle:Destroy() end end) end
        else
            pcall(function() if lightData and lightData.Parent then lightData:Destroy() end end)
        end
    end
    for _, shellData in ipairs(layerData.shells or {}) do pcall(function() if shellData.part and shellData.part.Parent then shellData.part:Destroy() end end) end
    for _, shellData in ipairs(layerData.secondShells or {}) do pcall(function() if shellData.part and shellData.part.Parent then shellData.part:Destroy() end end) end
    for _, w in ipairs(layerData.welds or {}) do pcall(function() if w and w.Parent then w:Destroy() end end) end
end

-- Also clean any leftover named instances from character
local function DeepCleanESP(character)
    if not character then return end
    for _, child in pairs(character:GetDescendants()) do
        if child.Name and child.Name:sub(1, 7) == "X3_ESP_" then
            pcall(function() child:Destroy() end)
        end
    end
    -- Legacy cleanup
    for _, child in pairs(character:GetChildren()) do
        if child.Name == "X3_GlowInner" or child.Name == "X3_GlowOuter" then
            pcall(function() child:Destroy() end)
        end
    end
    for _, partName in ipairs(R6Parts) do
        local part = character:FindFirstChild(partName)
        if part then
            for _, child in pairs(part:GetChildren()) do
                if child.Name == "X3_GlowLight" or child.Name:sub(1, 7) == "X3_ESP_" then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end
end


-- ============================================
-- MASTER ESP CONTROLLER
-- Replaces the old StartChams/StopChams/UpdateAllChams system
-- ============================================
-- PlayerGlowData is reused from the original script (already declared globally)

-- Override the global functions that the rest of the script calls
CreateHighlight = function(player)
    if not player.Character then return nil end
    local baseColor, isTeammate = GetPlayerESPColor(player)
    local mode = ESPModes[ChamsMode]
    if not mode then mode = ESPModes["CS2 Glow"] end

    local layerData = mode.Setup(player, player.Character, baseColor, isTeammate)
    PlayerGlowData[player] = layerData
    -- Return first highlight for backwards compatibility with PlayerHighlights
    return layerData.highlights and layerData.highlights[1] or nil
end

RemoveHighlight = function(character)
    DeepCleanESP(character)
end

UpdateHighlightColors = function()
    -- This is now handled by the animation loop per-mode Update function
    -- But we need to handle static updates when animation is off
    for player, layerData in pairs(PlayerGlowData) do
        if not layerData then continue end
        local color = GetPlayerESPColor(player)
        local mode = ESPModes[ChamsMode]
        if mode and mode.Update then
            mode.Update(player, layerData, color, 0.016, tick())
        end
    end
end

-- Master animation loop that drives all ESP modes
local ESPAnimationConnection = nil
local ESPAnimationTime = 0

local function StartESPAnimationLoop()
    if ESPAnimationConnection then return end
    ESPAnimationTime = tick()
    ESPAnimationConnection = RunService.Heartbeat:Connect(function(dt)
        if not ChamsEnabled then return end
        local t = tick() - ESPAnimationTime + 100 -- offset to avoid t=0 weirdness

        local mode = ESPModes[ChamsMode]
        if not mode or not mode.Update then return end

        for player, layerData in pairs(PlayerGlowData) do
            if not layerData then continue end
            if not player.Character then continue end
            local baseColor = GetPlayerESPColor(player)
            local ok, err = pcall(mode.Update, player, layerData, baseColor, dt, t)
            if not ok then
                warn("X3 ESP Update error: " .. tostring(err))
            end
        end
    end)
end

local function StopESPAnimationLoop()
    if ESPAnimationConnection then
        ESPAnimationConnection:Disconnect()
        ESPAnimationConnection = nil
    end
end

-- Override RemoveChamsFromPlayer
RemoveChamsFromPlayer = function(player)
    if player.Character then DeepCleanESP(player.Character) end
    if PlayerGlowData[player] then
        CleanupESPLayers(PlayerGlowData[player])
        PlayerGlowData[player] = nil
    end
    if PlayerConnections[player] and PlayerConnections[player].HealthChanged then
        PlayerConnections[player].HealthChanged:Disconnect()
        PlayerConnections[player].HealthChanged = nil
    end
    PlayerHighlights[player] = nil
end

-- Override UpdateAllChams
UpdateAllChams = function()
    local ap = Players:GetPlayers()
    for i = 1, #ap do
        if ChamsEnabled then SetupChamsForPlayer(ap[i])
        else RemoveChamsFromPlayer(ap[i]) end
    end
end

-- Override StartChams
StartChams = function()
    local ap = Players:GetPlayers()
    for i = 1, #ap do
        local p = ap[i]
        SetupChamsForPlayer(p)
        if not PlayerConnections[p] then PlayerConnections[p] = {} end
        if PlayerConnections[p].ChamsCharacterAdded then PlayerConnections[p].ChamsCharacterAdded:Disconnect() end
        PlayerConnections[p].ChamsCharacterAdded = p.CharacterAdded:Connect(function()
            task.wait(0.2)
            if ChamsEnabled then SetupChamsForPlayer(p) end
        end)
    end

    if ActiveConnections.ChamsPlayerAdded then ActiveConnections.ChamsPlayerAdded:Disconnect() end
    ActiveConnections.ChamsPlayerAdded = Players.PlayerAdded:Connect(function(p)
        task.wait(1)
        if ChamsEnabled then
            SetupChamsForPlayer(p)
            if not PlayerConnections[p] then PlayerConnections[p] = {} end
            PlayerConnections[p].ChamsCharacterAdded = p.CharacterAdded:Connect(function()
                task.wait(0.2)
                if ChamsEnabled then SetupChamsForPlayer(p) end
            end)
        end
    end)

    if ActiveConnections.ChamsPlayerRemoving then ActiveConnections.ChamsPlayerRemoving:Disconnect() end
    ActiveConnections.ChamsPlayerRemoving = Players.PlayerRemoving:Connect(function(p)
        RemoveChamsFromPlayer(p)
        if PlayerConnections[p] and PlayerConnections[p].ChamsCharacterAdded then
            PlayerConnections[p].ChamsCharacterAdded:Disconnect()
            PlayerConnections[p].ChamsCharacterAdded = nil
        end
    end)

    -- Start the master animation loop
    StartESPAnimationLoop()
end

-- Override StopChams
StopChams = function()
    StopESPAnimationLoop()
    local ap = Players:GetPlayers()
    for i = 1, #ap do
        RemoveChamsFromPlayer(ap[i])
        if PlayerConnections[ap[i]] and PlayerConnections[ap[i]].ChamsCharacterAdded then
            PlayerConnections[ap[i]].ChamsCharacterAdded:Disconnect()
            PlayerConnections[ap[i]].ChamsCharacterAdded = nil
        end
    end
    if ActiveConnections.ChamsPlayerAdded then ActiveConnections.ChamsPlayerAdded:Disconnect(); ActiveConnections.ChamsPlayerAdded = nil end
    if ActiveConnections.ChamsPlayerRemoving then ActiveConnections.ChamsPlayerRemoving:Disconnect(); ActiveConnections.ChamsPlayerRemoving = nil end
    PlayerHighlights = {}
    PlayerGlowData = {}
end


