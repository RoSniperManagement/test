local function Fade(t) return t * t * t * (t * (t * 6 - 15) + 10) end
local function Lerp(a, b, t) return a + t * (b - a) end
local function Grad(hash, x, y)
    local h = hash % 4
    if h == 0 then return x + y
    elseif h == 1 then return -x + y
    elseif h == 2 then return x - y
    else return -x - y end
end

-- 2D Perlin noise, returns [-1, 1]
local function Perlin2D(x, y)
    local xi = math.floor(x) % 256
    local yi = math.floor(y) % 256
    local xf = x - math.floor(x)
    local yf = y - math.floor(y)
    local u = Fade(xf)
    local v = Fade(yf)
    local aa = PERM[PERM[xi] + yi]
    local ab = PERM[PERM[xi] + yi + 1]
    local ba = PERM[PERM[xi + 1] + yi]
    local bb = PERM[PERM[xi + 1] + yi + 1]
    return Lerp(
        Lerp(Grad(aa, xf, yf), Grad(ba, xf - 1, yf), u),
        Lerp(Grad(ab, xf, yf - 1), Grad(bb, xf - 1, yf - 1), u),
        v
    )
end

-- Fractal Brownian Motion - layered noise for organic movement
local function FBM(x, y, octaves, lacunarity, gain)
    octaves = octaves or 4
    lacunarity = lacunarity or 2.0
    gain = gain or 0.5
    local sum = 0
    local amp = 1
    local freq = 1
    local maxAmp = 0
    for i = 1, octaves do
        sum = sum + amp * Perlin2D(x * freq, y * freq)
        maxAmp = maxAmp + amp
        amp = amp * gain
        freq = freq * lacunarity
    end
    return sum / maxAmp
end

-- Golden ratio for non-repeating phase distribution
local PHI = (1 + math.sqrt(5)) / 2
local TAU = math.pi * 2

-- Asymmetric heartbeat waveform: fast attack, slow decay
local function HeartbeatWave(t, bpm)
    local period = 60 / (bpm or 72)
    local phase = (t % period) / period
    -- Double-peak cardiac waveform
    local p1 = math.exp(-((phase - 0.12) * 18) ^ 2) -- systolic peak
    local p2 = math.exp(-((phase - 0.28) * 22) ^ 2) * 0.45 -- dicrotic notch bounce
    local base = math.exp(-phase * 4) * 0.15 -- baseline decay
    return math.clamp(p1 + p2 + base, 0, 1)
end

-- Poisson-distributed random event generator
local PoissonState = {}
local function PoissonEvent(id, rate, dt)
    if not PoissonState[id] then PoissonState[id] = {timer = 0, active = false, cooldown = 0} end
    local s = PoissonState[id]
    s.cooldown = s.cooldown - dt
    if s.cooldown <= 0 then
        -- Probability of event in this frame: 1 - e^(-rate * dt)
        if math.random() < (1 - math.exp(-rate * dt)) then
            s.active = true
            s.timer = 0.05 + math.random() * 0.1 -- event duration
            s.cooldown = 0.1 / rate -- minimum gap
            return true
        end
    end
    if s.active then
        s.timer = s.timer - dt
        if s.timer <= 0 then s.active = false end
    end
    return s.active
end

-- Attempt hash for stable per-player randomness
local function StableHash(player, partIndex)
    local uid = player.UserId or 0
    return ((uid * 2654435761 + partIndex * 340573321) % 2147483647) / 2147483647
end

-- HSV utilities
local function ToHSV(c) return Color3.toHSV(c) end
local function FromHSV(h, s, v) return Color3.fromHSV(h % 1, math.clamp(s, 0, 1), math.clamp(v, 0, 1)) end
local function LerpColor3(c1, c2, a)
    return Color3.new(
        c1.R + (c2.R - c1.R) * a,
        c1.G + (c2.G - c1.G) * a,
        c1.B + (c2.B - c1.B) * a
    )
end

-- Attempt smoothstep for nice easing
local function Smoothstep(edge0, edge1, x)
    local t = math.clamp((x - edge0) / (edge1 - edge0), 0, 1)
    return t * t * (3 - 2 * t)
end

local function InverseSmoothstep(x)
    return 0.5 - math.sin(math.asin(1 - 2 * math.clamp(x, 0, 1)) / 3)
end


-- ============================================
-- ESP MODE DEFINITIONS
-- ============================================
-- Each mode is a table with:
--   .Name: display name
--   .Description: tooltip
--   .Setup(player, character, baseColor, isTeammate) -> layerData
--   .Update(player, layerData, baseColor, dt, globalTime) -> nil (mutates layers in place)
--   .Cleanup(layerData) -> nil

ESPModes = {}

-- Part index map for spatial calculations
local PartSpatialIndex = {
    ["Left Leg"] = {x = -0.5, y = -2, index = 0},
    ["Right Leg"] = {x = 0.5, y = -2, index = 1},
    ["Torso"] = {x = 0, y = 0, index = 2},
    ["Left Arm"] = {x = -1.5, y = 0, index = 3},
    ["Right Arm"] = {x = 1.5, y = 0, index = 4},
    ["Head"] = {x = 0, y = 1.5, index = 5},
}

-- ============================================
-- MODE 1: CLASSIC CS2 GLOW
-- Multi-layer fresnel-approximated glow with inner/outer separation
-- ============================================
ESPModes["CS2 Glow"] = {
    Name = "CS2 Glow",
    Description = "Multi-layer glow with inner/outer color separation and edge bloom",
    
    Setup = function(player, character, baseColor, isTeammate)
        local layers = {highlights = {}, lights = {}, shells = {}, welds = {}}
        
        -- Layer 1: Inner core highlight (tight, bright, low fill)
        local hlInner = Instance.new("Highlight")
        hlInner.Name = "X3_ESP_Inner"
        hlInner.Adornee = character
        hlInner.FillColor = baseColor
        hlInner.FillTransparency = 0.82
        hlInner.OutlineColor = baseColor
        hlInner.OutlineTransparency = 0.0
        hlInner.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hlInner.Parent = character
        table.insert(layers.highlights, hlInner)
        
        -- Per-part lights with face-specific glow
        for _, partName in ipairs(R6Parts) do
            local part = character:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                -- Primary point light for ambient glow
                local pointLight = Instance.new("PointLight")
                pointLight.Name = "X3_ESP_Glow"
                pointLight.Color = baseColor
                pointLight.Brightness = ChamsGlowIntensity * 1.8
                pointLight.Range = 5 + (ChamsGlowIntensity * 4)
                pointLight.Shadows = false
                pointLight.Parent = part
                table.insert(layers.lights, pointLight)
                
                -- Surface lights on key faces for directional bleed
                if partName == "Torso" or partName == "Head" then
                    for _, face in ipairs({Enum.NormalId.Front, Enum.NormalId.Back}) do
                        local surfLight = Instance.new("SurfaceLight")
                        surfLight.Name = "X3_ESP_Surface"
                        surfLight.Color = baseColor
                        surfLight.Brightness = ChamsGlowIntensity * 0.8
                        surfLight.Range = 3
                        surfLight.Angle = 120
                        surfLight.Face = face
                        surfLight.Shadows = false
                        surfLight.Parent = part
                        table.insert(layers.lights, surfLight)
                    end
                end
                
                -- Glow shell: slightly oversized neon clone for volumetric feel
                local shell = Instance.new("Part")
                shell.Name = "X3_ESP_Shell"
                shell.Size = part.Size * 1.06
                shell.CFrame = part.CFrame
                shell.Material = Enum.Material.Neon
                shell.Color = baseColor
                shell.Transparency = 0.88
                shell.CanCollide = false
                shell.CanQuery = false
                shell.CanTouch = false
                shell.Massless = true
                shell.Anchored = false
                shell.CastShadow = false
                shell.Parent = character
                
                -- Copy mesh for Head
                if partName == "Head" then
                    local mesh = Instance.new("SpecialMesh", shell)
                    mesh.MeshType = Enum.MeshType.Head
                    mesh.Scale = Vector3.new(1.25 * 1.06, 1.25 * 1.06, 1.25 * 1.06)
                end
                
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = part
                weld.Part1 = shell
                weld.Parent = shell
                
                table.insert(layers.shells, {part = shell, source = part, partName = partName})
                table.insert(layers.welds, weld)
            end
        end
        
        return layers
    end,
    
    Update = function(player, layers, baseColor, dt, t)
        -- Subtle organic breathing on the inner highlight
        local breathe = 0.5 + 0.5 * math.sin(t * 1.2 + StableHash(player, 0) * TAU)
        local fbmVal = FBM(t * 0.3, StableHash(player, 99) * 10, 3, 2.0, 0.5)
        local combinedPulse = breathe * 0.7 + (fbmVal * 0.5 + 0.5) * 0.3
        
        for _, hl in ipairs(layers.highlights) do
            if hl and hl.Parent then
                hl.FillColor = baseColor
                hl.OutlineColor = baseColor
                hl.FillTransparency = 0.78 + combinedPulse * 0.08
                hl.OutlineTransparency = math.clamp(0.05 + (1 - combinedPulse) * 0.15, 0, 0.4)
            end
        end
        
        for i, light in ipairs(layers.lights) do
            if light and light.Parent then
                light.Color = baseColor
                local lPulse = 0.5 + 0.5 * math.sin(t * 1.5 + i * PHI)
                light.Brightness = ChamsGlowIntensity * (1.2 + lPulse * 0.6)
            end
        end
        
        for _, shellData in ipairs(layers.shells) do
            local shell = shellData.part
            local source = shellData.source
            if shell and shell.Parent and source and source.Parent then
                shell.Color = baseColor
                -- Shells breathe in size subtly
                local sBreath = 1.04 + math.sin(t * 1.8 + (PartSpatialIndex[shellData.partName] or {index=0}).index * PHI) * 0.025
                shell.Size = source.Size * sBreath
                shell.Transparency = 0.85 + (1 - combinedPulse) * 0.08
            end
        end
    end,
}


-- ============================================
-- MODE 2: THERMAL VISION
-- Heat-map style rendering with temperature gradient and heat shimmer
-- ============================================
ESPModes["Thermal"] = {
    Name = "Thermal",
    Description = "Heat-signature vision with temperature gradient based on health and distance",
    
    Setup = function(player, character, baseColor, isTeammate)
        local layers = {highlights = {}, lights = {}, shells = {}, welds = {}}
        
        -- Thermal uses a specific color palette regardless of settings
        -- Hot (high health/close) = white -> yellow -> orange -> red
        -- Cold (low health/far) = red -> purple -> dark blue -> black
        
        local hl = Instance.new("Highlight")
        hl.Name = "X3_ESP_Thermal"
        hl.Adornee = character
        hl.FillColor = Color3.fromRGB(255, 200, 50) -- warm default
        hl.FillTransparency = 0.3
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0.5
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = character
        table.insert(layers.highlights, hl)
        
        -- Per-part heat shells with temperature variation
        for _, partName in ipairs(R6Parts) do
            local part = character:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                -- Heat glow (different intensity per body part)
                local light = Instance.new("PointLight")
                light.Name = "X3_ESP_Heat"
                light.Brightness = 2
                light.Range = 6
                light.Shadows = false
                light.Parent = part
                table.insert(layers.lights, {light = light, partName = partName})
                
                -- Thermal shell with part-specific heat variance
                local shell = Instance.new("Part")
                shell.Name = "X3_ESP_ThermalShell"
                shell.Size = part.Size * 1.03
                shell.CFrame = part.CFrame
                shell.Material = Enum.Material.Neon
                shell.Transparency = 0.7
                shell.CanCollide = false
                shell.CanQuery = false
                shell.CanTouch = false
                shell.Massless = true
                shell.Anchored = false
                shell.CastShadow = false
                shell.Parent = character
                
                if partName == "Head" then
                    local mesh = Instance.new("SpecialMesh", shell)
                    mesh.MeshType = Enum.MeshType.Head
                    mesh.Scale = Vector3.new(1.25 * 1.04, 1.25 * 1.04, 1.25 * 1.04)
                end
                
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = part; weld.Part1 = shell; weld.Parent = shell
                table.insert(layers.shells, {part = shell, source = part, partName = partName})
                table.insert(layers.welds, weld)
            end
        end
        
        return layers
    end,
    
    Update = function(player, layers, baseColor, dt, t)
        local hp = 1
        if player.Character then
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum then hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1) end
        end
        
        -- Distance factor (closer = hotter)
        local distFactor = 1
        local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local targetRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if localRoot and targetRoot then
            local dist = (localRoot.Position - targetRoot.Position).Magnitude
            distFactor = math.clamp(1 - (dist / 150), 0.1, 1)
        end
        
        -- Combined heat value
        local heat = hp * 0.6 + distFactor * 0.4
        
        -- Thermal palette mapping (0=cold/dark -> 1=hot/white)
        -- Black -> Dark Blue -> Purple -> Red -> Orange -> Yellow -> White
        local thermalColor
        if heat < 0.15 then
            thermalColor = LerpColor3(Color3.fromRGB(10, 0, 30), Color3.fromRGB(30, 0, 100), heat / 0.15)
        elseif heat < 0.3 then
            thermalColor = LerpColor3(Color3.fromRGB(30, 0, 100), Color3.fromRGB(140, 0, 120), (heat - 0.15) / 0.15)
        elseif heat < 0.5 then
            thermalColor = LerpColor3(Color3.fromRGB(140, 0, 120), Color3.fromRGB(220, 30, 0), (heat - 0.3) / 0.2)
        elseif heat < 0.7 then
            thermalColor = LerpColor3(Color3.fromRGB(220, 30, 0), Color3.fromRGB(255, 160, 0), (heat - 0.5) / 0.2)
        elseif heat < 0.85 then
            thermalColor = LerpColor3(Color3.fromRGB(255, 160, 0), Color3.fromRGB(255, 240, 100), (heat - 0.7) / 0.15)
        else
            thermalColor = LerpColor3(Color3.fromRGB(255, 240, 100), Color3.fromRGB(255, 255, 240), (heat - 0.85) / 0.15)
        end
        
        -- Heat shimmer: noise-driven perturbation
        local shimmerX = FBM(t * 2.5, StableHash(player, 7) * 100, 3) * 0.08
        local shimmerH, shimmerS, shimmerV = ToHSV(thermalColor)
        thermalColor = FromHSV(shimmerH + shimmerX, shimmerS, shimmerV)
        
        for _, hl in ipairs(layers.highlights) do
            if hl and hl.Parent then
                hl.FillColor = thermalColor
                hl.FillTransparency = 0.25 + (1 - heat) * 0.35
                hl.OutlineColor = heat > 0.6 and Color3.fromRGB(255, 255, 220) or thermalColor
                hl.OutlineTransparency = 0.3 + (1 - heat) * 0.4
            end
        end
        
        -- Per-part heat variation: extremities are cooler, torso/head are hotter
        local partHeatBias = {
            ["Head"] = 0.15, ["Torso"] = 0.1,
            ["Left Arm"] = -0.05, ["Right Arm"] = -0.05,
            ["Left Leg"] = -0.12, ["Right Leg"] = -0.12,
        }
        
        for _, lightData in ipairs(layers.lights) do
            local light = lightData.light
            local pn = lightData.partName
            if light and light.Parent then
                local partHeat = math.clamp(heat + (partHeatBias[pn] or 0), 0, 1)
                -- Remap heat to thermal color for this specific part
                local pH
                if partHeat > 0.5 then
                    pH = LerpColor3(Color3.fromRGB(220, 60, 0), Color3.fromRGB(255, 240, 120), (partHeat - 0.5) / 0.5)
                else
                    pH = LerpColor3(Color3.fromRGB(40, 0, 80), Color3.fromRGB(220, 60, 0), partHeat / 0.5)
                end
                light.Color = pH
                light.Brightness = 1 + partHeat * 3
                light.Range = 3 + partHeat * 5
            end
        end
        
        for _, shellData in ipairs(layers.shells) do
            local shell = shellData.part
            local source = shellData.source
            local pn = shellData.partName
            if shell and shell.Parent and source and source.Parent then
                local partHeat = math.clamp(heat + (partHeatBias[pn] or 0), 0, 1)
                -- Individual noise per shell for shimmer effect
                local noiseVal = Perlin2D(t * 3 + (PartSpatialIndex[pn] or {index=0}).index * 3.7, StableHash(player, 20) * 50)
                local shimmer = partHeat + noiseVal * 0.08
                
                local sColor
                if shimmer > 0.5 then
                    sColor = LerpColor3(Color3.fromRGB(200, 40, 0), Color3.fromRGB(255, 230, 80), (shimmer - 0.5) / 0.5)
                else
                    sColor = LerpColor3(Color3.fromRGB(30, 0, 70), Color3.fromRGB(200, 40, 0), shimmer / 0.5)
                end
                shell.Color = sColor
                shell.Transparency = 0.65 + (1 - partHeat) * 0.25
                -- Heat makes shells expand slightly (thermal blooming)
                shell.Size = source.Size * (1.02 + partHeat * 0.04 + math.abs(noiseVal) * 0.015)
            end
        end
    end,
}


