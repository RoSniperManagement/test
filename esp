-- MODE 3: PLASMA FIELD
-- Interference-pattern driven dual-sine color fields
-- ============================================
ESPModes["Plasma"] = {
    Name = "Plasma",
    Description = "Interference-pattern plasma with overlapping wave fields",
    
    Setup = function(player, character, baseColor, isTeammate)
        local layers = {highlights = {}, lights = {}, shells = {}, welds = {}}
        
        local hl = Instance.new("Highlight")
        hl.Name = "X3_ESP_Plasma"
