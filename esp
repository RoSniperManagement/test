                shell.Parent = character
                
                if partName == "Head" then
                    local mesh = Instance.new("SpecialMesh", shell)
                    mesh.MeshType = Enum.MeshType.Head
                    mesh.Scale = Vector3.new(1.25*1.05,1.25*1.05,1.25*1.05)
                end
                
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = part; weld.Part1 = shell; weld.Parent = shell
                table.insert(layers.shells, {part = shell, source = part, partName = partName})
                table.insert(layers.welds, weld)
            end
        end
        
        return layers
    end,
    
    Update = function(player, layers, baseColor, dt, t)
        -- BPM tied to health: low health = fast panicked heartbeat
        local hp = 1
        if player.Character then
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum then hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1) end
        end
        local bpm = 60 + (1 - hp) * 120 -- 60 bpm at full health, 180 bpm at near-death
        local beat = HeartbeatWave(t, bpm)
        
        -- Color shifts with health: healthy = warm red, dying = cold blue-white
        local healthColor
        if hp > 0.5 then
            healthColor = LerpColor3(Color3.fromRGB(220, 40, 40), Color3.fromRGB(180, 0, 0), (1 - hp) * 2)
        else
            healthColor = LerpColor3(Color3.fromRGB(180, 0, 0), Color3.fromRGB(100, 120, 200), (0.5 - hp) * 2)
        end
        
        for _, hl in ipairs(layers.highlights) do
            if hl and hl.Parent then
                hl.FillColor = healthColor
                hl.OutlineColor = LerpColor3(healthColor, Color3.new(1, 1, 1), beat * 0.5)
                hl.FillTransparency = 0.65 - beat * 0.25
                hl.OutlineTransparency = 0.3 - beat * 0.25
            end
        end
        
        -- Cardiac propagation: the pulse travels from torso outward
        -- Parts further from torso get a delayed beat
        local propagationDelay = {
            ["Torso"] = 0,
            ["Head"] = 0.06,
            ["Left Arm"] = 0.08,
            ["Right Arm"] = 0.08,
            ["Left Leg"] = 0.12,
            ["Right Leg"] = 0.12,
        }
        
        for _, lightData in ipairs(layers.lights) do
            local light = lightData.light
            local pn = lightData.partName
            if light and light.Parent then
                local delay = propagationDelay[pn] or 0
                local delayedBeat = HeartbeatWave(t - delay, bpm)
                
                light.Color = LerpColor3(healthColor, Color3.new(1, 0.9, 0.9), delayedBeat * 0.4)
                light.Brightness = 1 + delayedBeat * 4
                light.Range = 3 + delayedBeat * 8
            end
        end
        
        for _, shellData in ipairs(layers.shells) do
            local shell = shellData.part
            local source = shellData.source
            local pn = shellData.partName
            if shell and shell.Parent and source and source.Parent then
                local delay = propagationDelay[pn] or 0
                local delayedBeat = HeartbeatWave(t - delay, bpm)
                
                shell.Color = LerpColor3(healthColor, Color3.new(1, 0.8, 0.8), delayedBeat * 0.3)
                shell.Transparency = 0.85 - delayedBeat * 0.3
                -- Shells expand on each beat
                shell.Size = source.Size * (1.03 + delayedBeat * 0.06)
            end
        end
    end,
}


